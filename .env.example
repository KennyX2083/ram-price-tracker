# ==========================================
# Discord
# ==========================================

DISCORD_WEBHOOK_URL=

# ==========================================
# Database
# ==========================================

DATABASE_PATH=data/ram_prices.db

# ==========================================
# Deal Detection
# ==========================================

MAX_PRICE=300

# Alert when price is at least this far below
# the 30-day average (20% = 0.20)
DISCOUNT_THRESHOLD=0.20

# Minimum history required before using the
# rolling-average alert.
MINIMUM_HISTORY_OBSERVATIONS=3
MINIMUM_HISTORY_DAYS=1

# Prevent duplicate alerts for this many hours.
ALERT_COOLDOWN_HOURS=24

# ==========================================
# Best Buy
# ==========================================

BEST_BUY_API_KEY=

# ==========================================
# Amazon (Creators API)
# ==========================================

AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com